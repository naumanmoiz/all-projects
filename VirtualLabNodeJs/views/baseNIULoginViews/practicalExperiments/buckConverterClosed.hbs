	<contenttext>
		<h2 style="margin-top:10px;">Practical Experiment 4 : Buck Converter Closed</h2>
		<br>

		<!-- Start of Content -->

		<!-- Start of Graph -->
		{{#if resultData}}
		<div class="row">
			<div class="col-lg-12 col-md-12" id="graphD3">

				<script type="text/javascript" src="https://d3js.org/d3.v3.min.js"></script>
				<script type="text/javascript">
					var dataJSON = "{{ resultData }}";
					dataJSON = JSON.parse(dataJSON.replace(/&quot;/g, '"'));

					var Tic1 = [];
					var VoClosed1 = [];
					var VoClosed1Temp = [];

					var Tic2 = [];
					var VoClosed2 = [];
					var VoClosed2Temp = [];

					var Tic3 = [];
					var VoClosed3 = [];
					var VoClosed3Temp = [];

					var xMaxRange = null;
					var yMaxRange = null;
					var xMinRange = null;
					var yMinRange = null;

					for (i in dataJSON["TiC1"]) {
						Tic1[i] = dataJSON["TiC1"][i];
						if (Tic1[i] < Tic1[i - 1]) {
							xMinRange = Tic1[i];
						}

						VoClosed1Temp[i] = dataJSON["VoClosed1"][0][i];
						VoClosed1.push(VoClosed1Temp[i][0]);
						if (VoClosed1[i] < VoClosed1[i - 1]) {
							yMinRange = VoClosed1[i];
						}
						if (VoClosed1[i] > VoClosed1[i - 1]) {
							yMaxRange = VoClosed1[i];
						}
					}

					for (i in dataJSON["TiC2"]) {
						Tic2[i] = dataJSON["TiC2"][i];

						VoClosed2Temp[i] = dataJSON["VoClosed2"][0][i];
						VoClosed2.push(VoClosed2Temp[i][0]);
						if (VoClosed1[i] < VoClosed1[i - 1]) {
							yMinRange = VoClosed1[i];
						}
						if (VoClosed2[i] > VoClosed2[i - 1]) {
							yMaxRange = VoClosed2[i];
						}
					}

					for (i in dataJSON["TiC3"]) {
						Tic3[i] = dataJSON["TiC3"][i];
						if (Tic3[i] > Tic3[i - 1]) {
							xMaxRange = Tic3[i];
						}

						VoClosed3Temp[i] = dataJSON["Outputs Data"][0][i];
						VoClosed3.push(VoClosed3Temp[i][0]);
						if (VoClosed3[i] < VoClosed3[i - 1]) {
							yMinRange = VoClosed3[i];
						}
						if (VoClosed3[i] > VoClosed3[i - 1]) {
							yMaxRange = VoClosed3[i];
						}
					}

					var data = [
						[{ 'x': m[0], 'y': n[0] }]
					];

					for (j in dataJSON["TiC1"]) {
						data[0].push({
							'x': Tic1[j],
							'y': VoClosed1[j]
						});
					}

					for (j in dataJSON["TiC2"]) {
						data[0].push({
							'x': Tic2[j],
							'y': VoClosed2[j]
						});
					}

					for (j in dataJSON["TiC3"]) {
						data[0].push({
							'x': Tic3[j],
							'y': VoClosed3[j]
						});
					}

					console.log(data);
				</script>
				<script type="text/javascript" src="/javascripts/graph.js"></script>
				<br><br>
				<a class="btn btn-primary" href="/users/practicalexperiments/buckConverterClosed">Return to Experiment</a>

			</div>
		</div>
		<!-- End of Graph -->

		<!-- Start of Form-->
		{{else}}
		<form class="form-horizontal" role="form" data-toggle="validator" method="POST" action="/users/practicalexperiments/buckConverterClosed">
			<div class="form-group">
				<label for="VO1BuckClosed" class="col-sm-2 control-label">VO1</label>
				<div class="col-sm-10">
					<input type="number" min="0" class="form-control" id="VO1BuckClosed" name="VO1BuckClosed" placeholder="Output Voltage 1"
					 required>
				</div>
			</div>
			<div class="form-group">
				<label for="VO2BuckClosed" class="col-sm-2 control-label">VO2</label>
				<div class="col-sm-10">
					<input type="number" min="0" class="form-control" id="VO2BuckClosed" name="VO2BuckClosed" placeholder="Output Voltage 2"
					 required>
				</div>
			</div>
			<div class="form-group">
				<label for="VO3BuckClosed" class="col-sm-2 control-label">VO3</label>
				<div class="col-sm-10">
					<input type="number" min="0" class="form-control" id="VO3BuckClosed" name="VO3BuckClosed" placeholder="Output Voltage 3"
					 required>
				</div>
			</div>
			<div class="form-group">
				<div class="col-sm-offset-2 col-sm-10">
					<button type="submit" class="btn btn-primary">Submit</button>
				</div>
			</div>
		</form>
		{{/if}}
