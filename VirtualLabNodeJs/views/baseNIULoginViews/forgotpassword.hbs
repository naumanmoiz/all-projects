	<contenttext>

		<h2 style="margin-top:10px;">Forgot Password</h2>
		<br>

		<!-- Start Forgot Password Form -->
		<form role="form">
			<div class="form-group">
				<label for="userForgotEmailAddress">Email address</label>
				<input type="email" class="form-control" id="userForgotEmailAddress" placeholder="Enter Email address" required="true">
			</div>
			<div class="form-group">
				<label for="userForgotSecurityAnswer">Security answer</label>
				<input type="name" class="form-control" id="userForgotSecurityAnswer" placeholder="Answer to the Security Question"
				 required="true">
			</div>
			<div class="alert alert-info" role="alert">
				<strong>Heads up!</strong> If you don't remember your email address and/or security answer please contact us at
				renewablelab@niu.edu
			</div>
			<!--
			<div class="alert alert-danger form-group" role="alert">
				<strong>Error!</strong> Please enter valid email address and security answer combination.
			</div>
			-->
			<button type="submit" class="btn btn-primary">Submit</button>
		</form>
		<!-- End Forgot Password Form -->

		<br>

	</contenttext>
</div>
