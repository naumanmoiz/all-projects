<br>
<!-- Start Main Content -->
<div class="col-sm-9 col-sm-push-3" id="contentwithleftnav">
	<contenttext>

		<h2 style="margin-top:10px;">Login</h2>
		<br>

		<!-- Start Login Form -->
		<form role="form" method="POST" action="/users/login">
			<div class="form-group">
				<label for="userEmailAddress">Email address</label>
				<input type="email" class="form-control" id="userEmailAddress" name="userEmailAddress" placeholder="Enter email address"
				 required="true">
			</div>
			<div class="form-group">
				<label for="userPassword">Password</label>
				<input type="password" class="form-control" id="userPassword" name="userPassword" placeholder="Password" required="true">
			</div>
			<!--
			<div class="alert alert-danger form-group" role="alert">
				<strong>Error!</strong> Please enter valid email address and password combination.
			</div>
			-->
			<a class="btn btn-link" href="/users/forgotpassword">Forgot Password</a>
			<br><br>
			<button type="submit" class="btn btn-primary">Sign in</button>
		</form>
		<!-- End Login Form -->

		<br>

	</contenttext>
</div>
<!-- End Main Content -->

<!-- Left bar div opening tag -->
<div class="col-sm-3 col-sm-pull-9 leftCol">