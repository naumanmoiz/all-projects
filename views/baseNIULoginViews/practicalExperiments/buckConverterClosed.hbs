				<label for="VO1BuckClosed" class="col-sm-2 control-label">VO1</label>
				<div class="col-sm-10">
					<input type="number" min="0" class="form-control" id="VO1BuckClosed" name="VO1BuckClosed"
					 placeholder="Output Voltage 1" required>
				</div>
			</div>
			<div class="form-group">
				<label for="VO2BuckClosed" class="col-sm-2 control-label">VO2</label>
				<div class="col-sm-10">
					<input type="number" min="0" class="form-control" id="VO2BuckClosed" name="VO2BuckClosed"
					 placeholder="Output Voltage 2" required>
				</div>
			</div>
			<div class="form-group">
				<label for="VO3BuckClosed" class="col-sm-2 control-label">VO3</label>
				<div class="col-sm-10">
					<input type="number" min="0" class="form-control" id="VO3BuckClosed" name="VO3BuckClosed"
					 placeholder="Output Voltage 3" required>
				</div>
			</div>
			<div class="form-group">
				<div class="col-sm-offset-2 col-sm-10">
					<button type="submit" class="btn btn-primary">Submit</button>
				</div>
			</div>
		</form>
		{{/if}}
