          <div class="input-group">
          <form method="post"  class="row" role="form" action="/users/register">
          
          
   <div class="form-group">
    <label>Name</label>
    <input type="text" class="form-control" placeholder="Name" name="name" autocomplete="off" required> 
  </div><br>
  
  <div class="form-group">
    <label>Username</label>
    <input type="text" class="form-control" placeholder="Username" name="username" autocomplete="off" required>
  </div><br>
   <div class="form-group">
    <label>Email</label>
    <input type="email" class="form-control" placeholder="Email" name="email" autocomplete="off" required>
  </div><br>
  <div class="form-group">
    <label>Password</label>
    <input type="password" class="form-control" placeholder="Password" name="password" autocomplete="off" required>
  </div><br>
  <div class="form-group">
    <label>Confirm Password</label>
    <input type="password" class="form-control" placeholder="Password" name="password2" autocomplete="off" required>
  </div>
  
        <div class="row"> <!--empty row to add some margin when in mobile view-->
        <br />
        </div>
        <br />
        <div class="row">
            <div class="pull-right">
                <button id="BtnSubmitLogin" type="submit" class="btn btn-danger form-controlx" aria-hidden="true" data-loading-text="Logging in...">Submit</button>
                <a href="http://renewablelab.niu.edu/users/login" class="btn btn-default form-controlx" role="button">Cancel</a>         
            </div>
